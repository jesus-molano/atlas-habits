# Optional Firebase sync. Leave these empty for the default local-only mode.
# All EXPO_PUBLIC_* values are embedded in the APK. Never put secrets here.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# OAuth client ID whose Google Cloud type is "Web application".
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Build-time file path used by app.config.ts. The JSON itself stays out of Git.
ATLAS_GOOGLE_SERVICES_FILE=
